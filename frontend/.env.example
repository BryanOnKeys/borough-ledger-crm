# Localmente dejar vacío: Vite envía /api hacia Spring Boot en :8080.
# En despliegue público, URL HTTPS del servidor Spring Boot, SIN /api/v1.
VITE_API_URL=

# Post-it de evaluación. Vite PUBLICA estos valores dentro del JavaScript del navegador.
# Usar únicamente una cuenta creada con rol VIEWER y datos totalmente ficticios.
# NUNCA colocar correo/contraseña del administrador ni credenciales MySQL.
# Definir estos dos valores en Vercel > Settings > Environment Variables
# y volver a desplegar el frontend para activar el Post-it.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
